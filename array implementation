class Stack:
    def __init__(self):
        self.Stack=[]
    def push(self,item):
        self.Stack.append(item)
        print(f"{item}pushed to stack")
    def pop(self):
        if self.is_empty():
            return "stack underflow"
        return self.Stack.pop()
    def peek(self):
        if self.is_empty():
            return "stack is empty"
        return self.stack[-1]
    def is_empty(self):
        return len(self.Stack)==0
    def size(self):
        return len(self.stack)
    def display(self):
        print("stack element:",self.Stack)
        
ob=Stack()

